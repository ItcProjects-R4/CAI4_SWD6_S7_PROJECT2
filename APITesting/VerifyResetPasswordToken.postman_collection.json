{
  "info": {
    "_postman_id": "f2b3c4d5-e6f7-8901-ghij-567890000005",
    "name": "VerifyResetPasswordToken",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "VerifyResetPasswordToken",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "// Updated to 401 as the API returns Unauthorized for invalid tokens",
              "pm.test('Status code is 401 for invalid token', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('success is false for invalid token', function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});",
              "",
              "pm.test('Message indicates invalid token', function () {",
              "    pm.expect(jsonData.message.toLowerCase()).to.include('token');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "email", "value": "practice@expandtesting.com", "type": "text" },
            { "key": "token", "value": "invalid-fake-token-for-testing", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/users/verify-reset-password-token",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "users", "verify-reset-password-token"]
        },
        "description": "Negative test case: Verifies that the API returns 401 when an invalid/fake reset token is provided."
      },
      "response": []
    }
  ]
}