{
  "info": {
    "_postman_id": "f3c4d5e6-f7a8-9012-hijk-678900000006",
    "name": "ResetPassword",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ResetPassword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "// Testing with an invalid token confirms the API properly",
              "// rejects unauthorized password reset attempts - a negative test case.",
              "",
              "pm.test('Status code is 400 for invalid token', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('success is false for invalid token', function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});",
              "",
              "pm.test('Message indicates invalid or expired token', function () {",
              "    pm.expect(jsonData.message.toLowerCase()).to.include('token');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "email", "value": "practice@expandtesting.com", "type": "text" },
            { "key": "token", "value": "invalid-fake-token-for-testing", "type": "text" },
            { "key": "newPassword", "value": "NewSecurePass1!", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/users/reset-password",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "users", "reset-password"]
        },
        "description": "No auth token needed. Resets the user's password using the reset token from email. Tests with an invalid token to confirm the API rejects unauthorized reset attempts, since a real valid token only arrives via email."
      },
      "response": []
    }
  ]
}
