    {
      "name": "LoginUser",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ============================================================",
              "// LoginUser — Assertions (Supports both individual & data-driven testing)",
              "// ============================================================",
              "",
              "const jsonData = pm.response.json();",
              "",
              "// Check if we're running with data-driven variables",
              "const caseDescription = pm.variables.get(\"caseDescription\");",
              "const expectedStatus = pm.variables.get(\"expectedStatus\");",
              "const expectedSuccess = pm.variables.get(\"expectedSuccess\");",
              "const expectedMessage = pm.variables.get(\"expectedMessage\");",
              "",
              "// Determine if we're in data-driven mode",
              "const isDataDriven = caseDescription !== undefined && expectedStatus !== undefined;",
              "",
              "if (isDataDriven) {",
              "    // ============================================================",
              "    // DATA-DRIVEN MODE (Collection Run with CSV/JSON)",
              "    // ============================================================",
              "    const expectedStatusCode = parseInt(expectedStatus);",
              "    const expectedSuccessValue = expectedSuccess === \"true\" || expectedSuccess === true;",
              "    ",
              "    pm.test(`[${caseDescription}] Status code is ${expectedStatusCode}`, function () {",
              "        pm.response.to.have.status(expectedStatusCode);",
              "    });",
              "    ",
              "    pm.test(`[${caseDescription}] success is ${expectedSuccessValue}`, function () {",
              "        pm.expect(jsonData.success).to.eql(expectedSuccessValue);",
              "    });",
              "    ",
              "    pm.test(`[${caseDescription}] Message is '${expectedMessage}'`, function () {",
              "        pm.expect(jsonData.message).to.eql(expectedMessage);",
              "    });",
              "    ",
              "    // For valid login: save the token for subsequent requests",
              "    if (expectedStatusCode === 200 && jsonData.data && jsonData.data.token) {",
              "        pm.environment.set(\"authToken\", jsonData.data.token);",
              "        console.log(\"✓ Auth token saved to environment\");",
              "    }",
              "} else {",
              "    // ============================================================",
              "    // INDIVIDUAL REQUEST MODE (Default validation)",
              "    // ============================================================",
              "    pm.test(\"Status code is 200 or 4xx\", function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 404]);",
              "    });",
              "    ",
              "    pm.test(\"Response has required structure\", function () {",
              "        pm.expect(jsonData).to.have.property(\"success\");",
              "        pm.expect(jsonData).to.have.property(\"status\");",
              "        pm.expect(jsonData).to.have.property(\"message\");",
              "    });",
              "    ",
              "    pm.test(\"success field is boolean\", function () {",
              "        pm.expect(jsonData.success).to.be.a(\"boolean\");",
              "    });",
              "    ",
              "    // If login is successful, validate data structure and save token",
              "    if (pm.response.code === 200 && jsonData.success === true) {",
              "        pm.test(\"Successful login has data object\", function () {",
              "            pm.expect(jsonData).to.have.property(\"data\");",
              "            pm.expect(jsonData.data).to.have.property(\"id\");",
              "            pm.expect(jsonData.data).to.have.property(\"name\");",
              "            pm.expect(jsonData.data).to.have.property(\"email\");",
              "            pm.expect(jsonData.data).to.have.property(\"token\");",
              "        });",
              "        ",
              "        // Save token for subsequent requests",
              "        if (jsonData.data && jsonData.data.token) {",
              "            pm.environment.set(\"authToken\", jsonData.data.token);",
              "            console.log(\"✓ Auth token saved to environment\");",
              "        }",
              "    }",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
