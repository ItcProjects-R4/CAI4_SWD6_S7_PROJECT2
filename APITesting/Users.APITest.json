  "item": [
    {
      "name": "RegisterUser",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ============================================================",
              "// RegisterUser — Assertions (driven by iteration variables)",
              "// ============================================================",
              "",
              "const jsonData = pm.response.json();",
              "const caseDescription = pm.variables.get(\"caseDescription\");",
              "const expectedStatus  = parseInt(pm.variables.get(\"expectedStatus\"));",
              "const expectedSuccess = pm.variables.get(\"expectedSuccess\") === \"true\" || pm.variables.get(\"expectedSuccess\") === true;",
              "const expectedMessage = pm.variables.get(\"expectedMessage\");",
              "",
              "pm.test(`[${caseDescription}] Status code is ${expectedStatus}`, function () {",
              "    pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "pm.test(`[${caseDescription}] success is ${expectedSuccess}`, function () {",
              "    pm.expect(jsonData.success).to.eql(expectedSuccess);",
              "});",
              "",
              "pm.test(`[${caseDescription}] Message is '${expectedMessage}'`, function () {",
              "    pm.expect(jsonData.message).to.eql(expectedMessage);",
              "});",
              "",
              "// For valid case: also assert the returned data shape",
              "if (expectedStatus === 201) {",
              "    pm.test(`[${caseDescription}] Response contains user id`, function () {",
              "        pm.expect(jsonData.data).to.have.property(\"id\");",
              "    });",
              "    pm.test(`[${caseDescription}] Response contains user email`, function () {",
              "        pm.expect(jsonData.data).to.have.property(\"email\");",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// ============================================================",
              "// RegisterUser — Iteration-driven test cases",
              "// Each iteration runs one scenario. The collection runner",
              "// should be set to iterate 4 times (one per case below).",
              "// ============================================================",
              "",
              "const uniqueSuffix = Date.now() + Math.floor(Math.random() * 1000);",
              "",
              "const testCases = [",
              "    {",
              "        // Case 1 — Valid registration (unique data each run)",
              "        description: \"Valid registration\",",
              "        name: `TestUser${uniqueSuffix}`,",
              "        email: `testuser_${uniqueSuffix}@test.com`,",
              "        password: \"Test1234!\",",
              "        expectedStatus: 201,",
              "        expectedSuccess: true,",
              "        expectedMessage: \"User account created successfully\"",
              "    },",
              "    {",
              "        // Case 2 — All fields empty",
              "        description: \"All fields empty\",",
              "        name: \"\",",
              "        email: \"\",",
              "        password: \"\",",
              "        expectedStatus: 400,",
              "        expectedSuccess: false,",
              "        expectedMessage: \"User name must be between 4 and 30 characters\"",
              "    },",
              "    {",
              "        // Case 3 — Missing email",
              "        description: \"Missing email\",",
              "        name: \"TestUser\",",
              "        email: \"\",",
              "        password: \"Test1234!\",",
              "        expectedStatus: 400,",
              "        expectedSuccess: false,",
              "        expectedMessage: \"A valid email address is required\"",
              "    },",
              "    {",
              "        // Case 4 — Invalid email format",
              "        description: \"Invalid email format\",",
              "        name: \"TestUser\",",
              "        email: \"notanemail\",",
              "        password: \"Test1234!\",",
              "        expectedStatus: 400,",
              "        expectedSuccess: false,",
              "        expectedMessage: \"A valid email address is required\"",
              "    }",
              "];",
              "",
              "// Pick the case for this iteration (loops back if more iterations than cases)",
              "const caseIndex = (pm.info.iteration || 0) % testCases.length;",
              "const currentCase = testCases[caseIndex];",
              "",
              "// Set iteration variables (visible in the Variables tab during a run)",
              "pm.variables.set(\"name\", currentCase.name);",
              "pm.variables.set(\"email\", currentCase.email);",
              "pm.variables.set(\"password\", currentCase.password);",
              "",
              "// Store expected values for assertions in the test script",
              "pm.variables.set(\"expectedStatus\", currentCase.expectedStatus);",
              "pm.variables.set(\"expectedSuccess\", currentCase.expectedSuccess);",
              "pm.variables.set(\"expectedMessage\", currentCase.expectedMessage);",
              "pm.variables.set(\"caseDescription\", currentCase.description);",
              "",
              "// For Case 1 (valid), also save to environment so Login can reuse the account",
              "if (caseIndex === 0) {",
              "    pm.environment.set(\"registeredEmail\", currentCase.email);",
              "    pm.environment.set(\"registeredPassword\", currentCase.password);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
