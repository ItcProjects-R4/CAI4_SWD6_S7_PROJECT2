{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-0123-defg-234567890002",
    "name": "UpdateUserProfile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "UpdateUserProfile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const loginRequest = {",
              "    url: 'https://practice.expandtesting.com/notes/api/users/login',",
              "    method: 'POST',",
              "    header: [",
              "        { key: 'Content-Type', value: 'application/x-www-form-urlencoded' },",
              "        { key: 'accept', value: 'application/json' }",
              "    ],",
              "    body: {",
              "        mode: 'urlencoded',",
              "        urlencoded: [",
              "            { key: 'email', value: pm.environment.get('registeredEmail') || 'practice@expandtesting.com' },",
              "            { key: 'password', value: pm.environment.get('registeredPassword') || 'SuperSecretPassword!' }",
              "        ]",
              "    }",
              "};",
              "",
              "pm.sendRequest(loginRequest, function (err, response) {",
              "    if (err) { console.error('Login pre-request failed:', err); return; }",
              "    const jsonData = response.json();",
              "    if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "        pm.environment.set('authToken', jsonData.data.token);",
              "        console.log('Auth token obtained and saved for UpdateUserProfile');",
              "    } else {",
              "        console.error('Login failed in pre-request:', jsonData.message);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('success is true', function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Message is 'Profile updated successful'\", function () {",
              "    pm.expect(jsonData.message).to.eql('Profile updated successful');",
              "});",
              "",
              "pm.test('Updated name matches sent name', function () {",
              "    pm.expect(jsonData.data.name).to.eql('Abdelrahman Mohamed');",
              "});",
              "",
              "pm.test('Updated phone matches sent phone', function () {",
              "    pm.expect(jsonData.data.phone).to.eql('01012345678');",
              "});",
              "",
              "pm.test('Updated company matches sent company', function () {",
              "    pm.expect(jsonData.data.company).to.eql('DEPI Automation Team');",
              "});",
              "",
              "pm.test('Response data has correct structure', function () {",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data).to.have.property('name');",
              "    pm.expect(jsonData.data).to.have.property('email');",
              "    pm.expect(jsonData.data).to.have.property('phone');",
              "    pm.expect(jsonData.data).to.have.property('company');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "x-auth-token", "value": "{{authToken}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "name", "value": "Abdelrahman Mohamed", "type": "text" },
            { "key": "phone", "value": "01012345678", "type": "text" },
            { "key": "company", "value": "DEPI Automation Team", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/users/profile",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "users", "profile"]
        }
      },
      "response": []
    }
  ]
}
