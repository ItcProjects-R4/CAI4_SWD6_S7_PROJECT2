{
  "info": {
    "_postman_id": "a1b2c3d4-1111-2222-3333-444455556666",
    "name": "CreateNote",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CreateNote",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('success is true', function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Message is 'Note successfully created'\", function () {",
              "    pm.expect(jsonData.message).to.eql('Note successfully created');",
              "});",
              "",
              "pm.test('Created title matches sent title', function () {",
              "    pm.expect(jsonData.data.title).to.eql('My Test Note');",
              "});",
              "",
              "pm.test('Created category matches sent category', function () {",
              "    pm.expect(jsonData.data.category).to.eql('Home');",
              "});",
              "",
              "pm.test('New note completed defaults to false', function () {",
              "    pm.expect(jsonData.data.completed).to.eql(false);",
              "});",
              "",
              "pm.test('Response data has correct structure', function () {",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data).to.have.property('title');",
              "    pm.expect(jsonData.data).to.have.property('description');",
              "    pm.expect(jsonData.data).to.have.property('category');",
              "    pm.expect(jsonData.data).to.have.property('user_id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "x-auth-token", "value": "{{authToken}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "title", "value": "My Test Note", "type": "text" },
            { "key": "description", "value": "This is a test note created for API testing", "type": "text" },
            { "key": "category", "value": "Home", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/notes",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "notes"]
        },
        "description": "Requires a valid auth token from login. Creates a new note with title, description, and category."
      },
      "response": []
    }
  ]
}
