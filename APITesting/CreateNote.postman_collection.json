{
  "info": {
    "_postman_id": "c1d2e3f4-a5b6-7890-cdef-123456789001",
    "name": "CreateNote",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CreateNote",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const loginRequest = {",
              "    url: 'https://practice.expandtesting.com/notes/api/users/login',",
              "    method: 'POST',",
              "    header: [",
              "        { key: 'Content-Type', value: 'application/x-www-form-urlencoded' },",
              "        { key: 'accept', value: 'application/json' }",
              "    ],",
              "    body: {",
              "        mode: 'urlencoded',",
              "        urlencoded: [",
              "            { key: 'email', value: pm.environment.get('registeredEmail') || 'practice@expandtesting.com' },",
              "            { key: 'password', value: pm.environment.get('registeredPassword') || 'SuperSecretPassword!' }",
              "        ]",
              "    }",
              "};",
              "",
              "pm.sendRequest(loginRequest, function (err, response) {",
              "    if (err) { console.error('Login pre-request failed:', err); return; }",
              "    const jsonData = response.json();",
              "    if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "        pm.environment.set('authToken', jsonData.data.token);",
              "        console.log('Auth token obtained and saved for CreateNote');",
              "    } else {",
              "        console.error('Login failed in pre-request:', jsonData.message);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('success is true', function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Message is 'Note successfully created'\", function () {",
              "    pm.expect(jsonData.message).to.eql('Note successfully created');",
              "});",
              "",
              "pm.test('Response contains note id', function () {",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data.id).to.be.a('string');",
              "});",
              "",
              "pm.test('Note title matches sent title', function () {",
              "    pm.expect(jsonData.data.title).to.eql('My Automation Note');",
              "});",
              "",
              "pm.test('Note category matches sent category', function () {",
              "    pm.expect(jsonData.data.category).to.eql('Work');",
              "});",
              "",
              "pm.test('Response data has correct structure', function () {",
              "    pm.expect(jsonData.data).to.have.property('title');",
              "    pm.expect(jsonData.data).to.have.property('description');",
              "    pm.expect(jsonData.data).to.have.property('category');",
              "    pm.expect(jsonData.data).to.have.property('completed');",
              "    pm.expect(jsonData.data).to.have.property('created_at');",
              "});",
              "",
              "if (jsonData.data && jsonData.data.id) {",
              "    pm.environment.set('noteId', jsonData.data.id);",
              "    console.log('Note ID saved:', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "x-auth-token", "value": "{{authToken}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "title", "value": "My Automation Note", "type": "text" },
            { "key": "description", "value": "This note was created by an automated Postman test", "type": "text" },
            { "key": "category", "value": "Work", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/notes",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "notes"]
        }
      },
      "response": []
    }
  ]
}
