{
  "info": {
    "_postman_id": "a1b2c3d4-aaaa-bbbb-cccc-ddddeeeeffff",
    "name": "GetProfile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GetProfile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('success is true', function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Message is 'Profile successful'\", function () {",
              "    pm.expect(jsonData.message).to.eql('Profile successful');",
              "});",
              "",
              "pm.test('Response data has correct structure', function () {",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data).to.have.property('name');",
              "    pm.expect(jsonData.data).to.have.property('email');",
              "});",
              "",
              "pm.test('Returned email is a valid string', function () {",
              "    pm.expect(jsonData.data.email).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "accept", "value": "application/json" },
          { "key": "x-auth-token", "value": "{{authToken}}" }
        ],
        "url": {
          "raw": "https://practice.expandtesting.com/notes/api/users/profile",
          "protocol": "https",
          "host": ["practice", "expandtesting", "com"],
          "path": ["notes", "api", "users", "profile"]
        },
        "description": "Requires a valid auth token from login. Returns the logged-in user's profile data."
      },
      "response": []
    }
  ]
}
